@using System.Security.Claims
@using HoopLog.Data.Models.Enums
@model TeamDetailsViewModel
@{
    ViewData["Title"] = Model.Name;
    var isCoach = Model.IsCoach;
    var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">@Model.Name</h1>
    <div>
        @if (isCoach)
        {
            <a class="btn btn-primary" asp-action="Progress" asp-route-id="@Model.Id">Player progress</a>
        }
        <a class="btn btn-outline-secondary" asp-action="Index">Back to teams</a>
    </div>
</div>

@if (isCoach)
{
    <div class="card mb-4">
        <div class="card-body d-flex justify-content-between align-items-center">
            <div>
                <div class="text-muted small">Join code (share with your players)</div>
                <div class="fs-4 font-monospace">@Model.JoinCode</div>
            </div>
            <form asp-action="RotateCode" asp-route-id="@Model.Id" method="post"
                  onsubmit="return confirm('Generate a new code? The current code will stop working.');">
                <button type="submit" class="btn btn-outline-danger">Rotate code</button>
            </form>
        </div>
    </div>
}

<h2 class="h5">Roster</h2>
<table class="table align-middle">
    <thead>
        <tr>
            <th>Member</th>
            <th>Role</th>
            <th>Joined (UTC)</th>
            @if (isCoach)
            {
                <th></th>
            }
        </tr>
    </thead>
    <tbody>
        @foreach (var m in Model.Members)
        {
            <tr>
                <td>@m.DisplayName@(m.UserId == currentUserId ? " (you)" : "")</td>
                <td><span class="badge @(m.Role == TeamRole.Coach ? "bg-warning text-dark" : "bg-secondary")">@m.Role</span></td>
                <td>@m.JoinedAt.ToString("dd-MM-yyyy")</td>
                @if (isCoach)
                {
                    <td class="text-end">
                        @if (m.UserId != currentUserId)
                        {
                            <form asp-action="RemoveMember" asp-route-id="@Model.Id" method="post" class="d-inline"
                                  onsubmit="return confirm('Remove this member from the team?');">
                                <input type="hidden" name="userId" value="@m.UserId" />
                                <button type="submit" class="btn btn-sm btn-outline-danger">Remove</button>
                            </form>
                        }
                    </td>
                }
            </tr>
        }
    </tbody>
</table>