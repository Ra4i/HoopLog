@model IEnumerable<HoopLog.Data.Models.TeamMembership>
@{
    ViewData["Title"] = "My Teams";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">My Teams</h1>
    <div>
        <a class="btn btn-primary" asp-action="Create">Create team</a>
        <a class="btn btn-outline-primary" asp-action="Join">Join with code</a>
    </div>
</div>

@if (!Model.Any())
{
    <p class="text-muted">You aren't in any teams yet. Create one as a coach, or join with a code from your coach.</p>
}
else
{
    <table class="table align-middle">
        <thead>
            <tr>
                <th>Team</th>
                <th>Your role</th>
                <th>Joined (UTC)</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var m in Model)
            {
                <tr>
                    <td>@m.Team.Name</td>
                    <td><span class="badge @(m.Role == HoopLog.Data.Models.Enums.TeamRole.Coach ? "bg-warning text-dark" : "bg-secondary")">@m.Role</span></td>
                    <td>@m.JoinedAt.ToString("d MMM yyyy")</td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@m.TeamId">Open</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}