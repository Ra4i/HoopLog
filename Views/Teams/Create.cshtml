@model HoopLog.ViewModels.CreateTeamInputModel
@{
    ViewData["Title"] = "Create team";
}

<h1 class="h3 mb-3">Create team</h1>

<form asp-action="Create" method="post" style="max-width: 480px;">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" autocomplete="off" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Create</button>
    <a class="btn btn-link" asp-action="Index">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}