@using Microsoft.AspNetCore.Identity
@using HoopLog.Data.Models
@inject SignInManager<User> SignInManager
@inject UserManager<User> UserManager

<ul class="navbar-nav">
    @if (SignInManager.IsSignedIn(User))
    {
        <li class="nav-item">
            <span class="nav-link nav-link-custom">Hello, @UserManager.GetUserName(User)</span>
        </li>
        <li class="nav-item">
            <form asp-controller="Account" asp-action="Logout" method="post">
                <button type="submit" class="nav-link nav-link-custom btn btn-link">Logout</button>
            </form>
        </li>
    }
    else
    {
        <li class="nav-item"><a class="nav-link nav-link-custom" asp-controller="Account" asp-action="Register">Register</a></li>
        <li class="nav-item"><a class="nav-link nav-link-custom" asp-controller="Account" asp-action="Login">Login</a></li>
    }
</ul>