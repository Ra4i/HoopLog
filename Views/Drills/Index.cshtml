@model DrillIndexViewModel

@{
    ViewData["Title"] = "Drills";
}

<style>
    .page-header {
        background: linear-gradient(135deg, #2D3561 0%, #1A1A2E 100%);
        color: white;
        padding: 2rem;
        border-radius: 15px;
        margin-bottom: 2rem;
        box-shadow: 0 4px 12px rgba(45, 53, 97, 0.15);
    }

    .page-header h1 {
        margin: 0;
        font-size: 2.5rem;
        font-weight: 800;
    }

    .page-header-icon {
        font-size: 3rem;
        margin-right: 1rem;
    }

    .page-title-container {
        display: flex;
        align-items: center;
    }

    .action-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 2rem;
        flex-wrap: wrap;
        gap: 1rem;
    }

    .no-drills {
        text-align: center;
        padding: 3rem;
        color: #666;
    }

    .no-drills-icon {
        font-size: 4rem;
        margin-bottom: 1rem;
        opacity: 0.5;
    }
</style>

<div class="page-header">
    <div class="page-title-container">
        <span class="page-header-icon">⚡</span>
        <div>
            <h1>Basketball Drills</h1>
            <p style="margin: 0.5rem 0 0 0; opacity: 0.9;">Master your skills with targeted drills</p>
        </div>
    </div>
</div>

<div class="action-header">
    <div>
        <a asp-controller="Drills" asp-action="Create" class="btn btn-primary">
            <span style="margin-right: 0.5rem;">➕</span> Add Team Drill
        </a>
    </div>
</div>

<h2 class="h4">Your Team Drills</h2>
@if (Model.TeamGroups.Any())
{
    @foreach (var group in Model.TeamGroups)
    {
        <h3 class="h5 mt-4">@group.Team.Name</h3>
        <table class="table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Category</th>
                    <th>Description</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in group.Drills)
                {
                    <tr>
                        <td><strong>@item.Name</strong></td>
                        <td>@item.Category.GetDisplayName()</td>
                        <td>@item.Description</td>
                        <td class="text-nowrap">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                            <form asp-action="Archive" asp-route-id="@item.Id" method="post" class="d-inline"
                                  onsubmit="return confirm('Archive this drill? Existing results will remain visible.');">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Archive</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
}
else
{
    <p class="text-muted">No active drills have been created for your teams yet.</p>
}
