@model IEnumerable<Drill>

@{
    ViewData["Title"] = "Drills";
}

<style>
    .page-header {
        background: linear-gradient(135deg, #2D3561 0%, #1A1A2E 100%);
        color: white;
        padding: 2rem;
        border-radius: 15px;
        margin-bottom: 2rem;
        box-shadow: 0 4px 12px rgba(45, 53, 97, 0.15);
    }

    .page-header h1 {
        margin: 0;
        font-size: 2.5rem;
        font-weight: 800;
    }

    .page-header-icon {
        font-size: 3rem;
        margin-right: 1rem;
    }

    .page-title-container {
        display: flex;
        align-items: center;
    }

    .action-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 2rem;
        flex-wrap: wrap;
        gap: 1rem;
    }

    .no-drills {
        text-align: center;
        padding: 3rem;
        color: #666;
    }

    .no-drills-icon {
        font-size: 4rem;
        margin-bottom: 1rem;
        opacity: 0.5;
    }
</style>

<div class="page-header">
    <div class="page-title-container">
        <span class="page-header-icon">⚡</span>
        <div>
            <h1>Basketball Drills</h1>
            <p style="margin: 0.5rem 0 0 0; opacity: 0.9;">Master your skills with targeted drills</p>
        </div>
    </div>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <strong>Error!</strong> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="action-header">
    <div>
        <a asp-controller="Drills" asp-action="Create" class="btn btn-primary">
            <span style="margin-right: 0.5rem;">➕</span> Add New Drill
        </a>
    </div>
</div>

@if (Model.Any())
{
    <table class="table">
        <thead>
            <tr>
                <th>⚽ Name</th>
                <th>🏷️ Category</th>
                <th>📝 Description</th>
                <th>⚙️ Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>
                        <strong>@item.Name</strong>
                    </td>
                    <td>
                        <span class="badge badge-primary">@item.Category</span>
                    </td>
                    <td>
                        <span style="color: #666;">@item.Description</span>
                    </td>
                    <td>
                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline"
                              onsubmit="return confirm('Delete this drill?');">
                            <button type="submit" class="btn btn-sm btn-outline-danger">🗑️ Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="card" style="border: 2px dashed #FF6B35;">
        <div class="card-body no-drills">
            <div class="no-drills-icon">🏀</div>
            <h5>No Drills Yet</h5>
            <p>Start creating drills to build your training library. Track your basketball training exercises and improve your skills!</p>
            <a asp-controller="Drills" asp-action="Create" class="btn btn-primary">
                Create Your First Drill
            </a>
        </div>
    </div>
}