@{
    ViewData["Title"] = "Home";
}

<div class="text-center my-5">
    <h1 class="display-5 fw-bold">HoopLog</h1>
    <p class="lead text-muted">Track your basketball training sessions and drills in one place.</p>

    <div class="d-flex justify-content-center gap-3 mt-4">
        <a asp-controller="Sessions" asp-action="Index" class="btn btn-primary btn-lg">
            View Sessions
        </a>
        <a asp-controller="Drills" asp-action="Index" class="btn btn-outline-secondary btn-lg">
            View Drills
        </a>
    </div>
</div>